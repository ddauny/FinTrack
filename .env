#Variabili d'ambiente per lo SVILUPPO
NODE_ENV=xxx

#password dell'utente postgres
POSTGRES_USER_PASSWORD=xxx

# Variabili del Database
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
POSTGRES_DB=xxx

#URL del Database (punta al nome del servizio 'db' in docker-compose)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

#Altre chiavi (es. JWT)
JWT_SECRET="xxx"

#URL Base per il client (se serve)
CLIENT_URL="http://localhost:xxx/"
