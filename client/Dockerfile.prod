# Build Stage
FROM node:22-alpine AS builder
WORKDIR /app
COPY client/package*.json ./
RUN npm install
COPY client/ .
RUN npm run build

# Production Stage - Nginx per servire file statici
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Se hai bisogno di una configurazione custom per il routing SPA (React Router)
# COPY client/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
