# FinTrack Environment Variables Template
# Copy this file to .env.development and .env.production and fill in the values

# General
NODE_ENV=development # development or production
PORT=4000
JWT_SECRET=development_secret_change_me

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=fintrack
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fintrack?schema=public

# Client
CLIENT_URL=http://localhost:5173

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Other
BACKUP_DIR=./backups
