generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  automationToken String? // JWT token for iPhone Shortcuts and automation
  isAiEnabled  Boolean   @default(false) // Access control for AI features

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets      Budget[]
  portfolios   Portfolio[]
  manualAssets ManualAsset[]
  assetGroups  AssetGroup[]
  tags         Tag[]
}

model Tag {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Account {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String
  type           String    // 'Checking', 'Savings', 'Credit Card', etc.
  initialBalance Decimal    @default(0.00)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
}

model Category {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String
  type           String    // 'Income' | 'Expense'
  color          String?
  isAssetLinked  Boolean   @default(false) // If true, transactions with this category can be linked to an asset item

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets  Budget[]
  txns     Transaction[] @relation("TxnCategory")
}

model Transaction {
  id         Int       @id @default(autoincrement())
  userId     Int
  accountId  Int
  categoryId Int
  date       DateTime
  amount     Decimal
  type       String    // 'Income' | 'Expense'
  notes      String?
  attachmentPath String? // Path to stored receipt/file
  createdAt  DateTime  @default(now())
  recurringTransactionId Int? // Link to recurring transaction if generated automatically
  splitGroupId String?  // UUID to group split transactions together
  parentSplitId Int?    // ID of the parent transaction if this is a split
  assetItemId  Int?     // Link to asset item for contribution tracking

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category  @relation("TxnCategory", fields: [categoryId], references: [id])
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  assetItem  AssetItem? @relation(fields: [assetItemId], references: [id], onDelete: SetNull)
  tags       Tag[]
  splits     Transaction[] @relation("TransactionSplits")
  parentSplit Transaction? @relation("TransactionSplits", fields: [parentSplitId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, splitGroupId])
  @@index([userId, accountId])
  @@index([userId, categoryId])
}

model RecurringTransaction {
  id           Int       @id @default(autoincrement())
  userId       Int
  accountId    Int
  categoryId   Int
  amount       Decimal
  type         String    // 'Income' | 'Expense'
  notes        String?
  frequency    String    // 'WEEKLY' | 'BIWEEKLY' | 'MONTHLY' | 'BIMONTHLY' | 'QUARTERLY' | 'SEMIANNUAL' | 'YEARLY'
  startDate    DateTime  // When to start generating transactions
  nextDate     DateTime  // Next scheduled transaction date
  endDate      DateTime? // Optional end date
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  assetItemId  Int?      // Link to asset item for contribution tracking

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetItem    AssetItem? @relation(fields: [assetItemId], references: [id], onDelete: SetNull)
  generatedTransactions Transaction[]

  @@index([userId, nextDate, isActive])
}

model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  amount     Decimal
  period     String   // 'Monthly' | 'Yearly'

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])
}

model Portfolio {
  id     Int      @id @default(autoincrement())
  userId Int
  name   String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]
}

model Holding {
  id               Int      @id @default(autoincrement())
  portfolioId      Int
  tickerSymbol     String
  quantity         Decimal
  avgPurchasePrice Decimal

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ManualAsset {
  id             Int      @id @default(autoincrement())
  userId         Int
  name           String
  type           String    // 'Real Estate', 'Vehicle', etc.
  estimatedValue Decimal
  associatedDebt Decimal    @default(0.00)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User-defined asset grouping for portfolio overview
model AssetGroup {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   // e.g., 'Stock & ETF', 'Cash', 'Real Estate'
  isInvestment Boolean @default(true) // Whether to include in portfolio analytics
  order     Int      @default(0) // Display order

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     AssetItem[]
}

model AssetItem {
  id                 Int         @id @default(autoincrement())
  groupId           Int?
  parentItemId      Int?
  name              String      // e.g., 'Trade Republic', 'Revolut', 'Recrowd'
  description       String?
  hidden            Boolean     @default(false)
  depreciationAmount Decimal?   // Monthly depreciation amount (e.g., 250.00)
  initialContribution Decimal?  // Starting capital/cost basis before transactions
  initialContributionDate DateTime? // Date/Month for the initial capital
  order             Int         @default(0) // Display order within group or parent

  group             AssetGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentItem        AssetItem?  @relation("AssetItemToChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  children          AssetItem[] @relation("AssetItemToChildren")
  valuations        AssetValuation[]
  transactions      Transaction[]
  recurringTransactions RecurringTransaction[]
}

// Snapshot values per month for each item
model AssetValuation {
  id        Int       @id @default(autoincrement())
  itemId    Int
  month     DateTime  // use first day of month
  value     Decimal
  formula   String?   // optional raw formula string (eg: =10+10)
  note      String?   // optional note attached to this valuation cell

  item      AssetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([itemId, month])
}


