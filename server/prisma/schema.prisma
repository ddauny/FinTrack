generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  automationToken String? // JWT token for iPhone Shortcuts and automation
  tokenVersion Int       @default(0) // bumped to invalidate every issued JWT (login + automation)

  // Per-user AI provider config for the screenshot-import feature.
  // Every user brings their own key — no shared/instance-wide fallback.
  screenshotAiProvider     String? // free-form label, e.g. "Gemini", "OpenAI", "Custom"
  screenshotAiBaseUrl      String? // e.g. https://generativelanguage.googleapis.com/v1beta/openai
  screenshotAiModel        String? // e.g. "gemini-2.5-flash"
  screenshotAiKeyEncrypted String? // ciphertext only, see server/src/utils/crypto.ts

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets      Budget[]
  portfolios   Portfolio[]
  manualAssets ManualAsset[]
  assetGroups  AssetGroup[]
  savingsGoals SavingsGoal[]
  tags         Tag[]
  externalIncomeSources ExternalIncomeSource[]
}

model ExternalIncomeSource {
  id              Int       @id @default(autoincrement())
  userId          Int
  name            String
  icon            String?
  color           String?
  apiUrl          String
  httpMethod      String    @default("GET") // "GET" | "POST"

  // Dynamic auth configuration
  authType        String    @default("BEARER") // "BEARER" | "API_KEY_HEADER" | "API_KEY_QUERY" | "CUSTOM_HEADER" | "NONE"
  authToken       String?
  authHeaderName  String?
  authQueryParam  String?

  // Dot-notation path in response JSON
  responseField   String

  // Cache metadata
  cacheTtlMinutes Int       @default(15)
  lastFetchedAt   DateTime?
  lastFetchedValue Decimal?
  lastFetchError  String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String
  type           String    // 'Checking', 'Savings', 'Credit Card', etc.
  initialBalance Decimal    @default(0.00)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
}

model Category {
  id       Int       @id @default(autoincrement())
  userId   Int
  name     String
  type     String    // 'Income' | 'Expense'

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets  Budget[]
  txns     Transaction[] @relation("TxnCategory")
}

model Transaction {
  id         Int       @id @default(autoincrement())
  userId     Int
  accountId  Int
  categoryId Int
  date       DateTime
  amount     Decimal
  type       String    // 'Income' | 'Expense'
  notes      String?
  createdAt  DateTime  @default(now())
  recurringTransactionId Int? // Link to recurring transaction if generated automatically

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category  @relation("TxnCategory", fields: [categoryId], references: [id])
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  tags       Tag[]

  @@index([userId, date])
}

model Tag {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String
  color        String        @default("#6366f1") // hex color

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model RecurringTransaction {
  id           Int       @id @default(autoincrement())
  userId       Int
  accountId    Int
  categoryId   Int
  amount       Decimal
  type         String    // 'Income' | 'Expense'
  notes        String?
  frequency    String    // 'WEEKLY' | 'BIWEEKLY' | 'MONTHLY' | 'BIMONTHLY' | 'QUARTERLY' | 'YEARLY'
  startDate    DateTime  // When to start generating transactions
  nextDate     DateTime  // Next scheduled transaction date
  endDate      DateTime? // Optional end date
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedTransactions Transaction[]

  @@index([userId, nextDate, isActive])
}

model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  amount     Decimal
  period     String   // 'Monthly' | 'Yearly'

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])
}

model Portfolio {
  id     Int      @id @default(autoincrement())
  userId Int
  name   String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings Holding[]
}

model Holding {
  id               Int      @id @default(autoincrement())
  portfolioId      Int
  tickerSymbol     String
  quantity         Decimal
  avgPurchasePrice Decimal

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model ManualAsset {
  id             Int      @id @default(autoincrement())
  userId         Int
  name           String
  type           String    // 'Real Estate', 'Vehicle', etc.
  estimatedValue Decimal
  associatedDebt Decimal    @default(0.00)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User-defined asset grouping for portfolio overview
model AssetGroup {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   // e.g., 'Stock & ETF', 'Cash', 'Real Estate'
  order     Int      @default(0) // Display order

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     AssetItem[]
}

model AssetItem {
  id                 Int         @id @default(autoincrement())
  groupId           Int?
  parentItemId      Int?
  name              String      // e.g., 'Trade Republic', 'Revolut', 'Recrowd'
  description       String?
  hidden            Boolean     @default(false)
  depreciationAmount Decimal?   // Monthly depreciation amount (e.g., 250.00)
  order             Int         @default(0) // Display order within group or parent

  group             AssetGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentItem        AssetItem?  @relation("AssetItemToChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  children          AssetItem[] @relation("AssetItemToChildren")
  valuations        AssetValuation[]
  bondData          BondData?
}

// Snapshot values per month for each item
model AssetValuation {
  id        Int       @id @default(autoincrement())
  itemId    Int
  month     DateTime  // use first day of month
  value     Decimal
  formula   String?   // optional raw formula string (eg: =10+10)
  note      String?   // optional note attached to this valuation cell

  item      AssetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([itemId, month])
}

// Bond/BTP data linked to an AssetItem (1:1)
model BondData {
  id                Int       @id @default(autoincrement())
  itemId            Int       @unique
  isin              String?            // e.g. "IT0005532715"
  purchaseDate      DateTime?          // Data di acquisto
  nominalValue      Decimal            // Valore nominale (es. 10000)
  purchasePrice     Decimal   @default(100) // Prezzo di carico (es. 98.50 = sotto la pari)
  bankCommissions   Decimal   @default(0)   // Commissioni bancarie
  maturityDate      DateTime           // Data di scadenza
  couponRate        Decimal?           // Tasso fisso annuo lordo (es. 4.00) — null se ha scaglioni
  couponFrequency   Int       @default(6)   // Frequenza cedola in mesi (6 = semestrale)
  taxRate           Decimal   @default(12.5) // Aliquota fiscale (12.5% titoli di stato)
  linkedAccountId   Int?               // Account per l'accredito cedole
  linkedCategoryId  Int?               // Categoria per le cedole

  item              AssetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  couponTiers       CouponTier[]
}

// Scaglioni di tasso per BTP Valore
model CouponTier {
  id          Int       @id @default(autoincrement())
  bondId      Int
  fromYear    Int                // Anno di inizio scaglione (1 = primo anno)
  toYear      Int                // Anno di fine scaglione (incluso)
  rate        Decimal            // Tasso annuo lordo per questo scaglione (es. 3.25)

  bond        BondData  @relation(fields: [bondId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  deadline      DateTime?
  icon          String?   // emoji
  color         String?   // hex color
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

